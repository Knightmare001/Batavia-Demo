# === Memoria Lab -- Contoh env ===
# Salin menjadi .env dan isi JWT_SECRET.
# JANGAN commit .env ke git.

# Mode. Nilai valid: lab, produksi. Lab mematikan CSP, memaksa seed opsional,
# dan menyalakan beberapa fitur dev-only.
MODE=lab

# Port backend. Range lab: 6080-6099.
PORT=6080

# Database. Lab pakai SQLite file lokal. Produksi akan ganti ke
# postgresql://... di versi backend/ (bukan backend-lab/).
DATABASE_URL="file:./dev.db"

# JWT. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Pastikan >= 32 byte random.
JWT_SECRET=ganti-ini-sebelum-run-pertama
JWT_EXPIRES_IN=12h

# Origin frontend yang diizinkan CORS. Boleh koma untuk banyak.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Direktori penyimpanan lampiran. Relatif terhadap backend-lab/.
STORAGE_DIR=./storage

# Rate limit login (dev longgar OK, tetap pakai nilai produksi untuk konsistensi uji).
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
